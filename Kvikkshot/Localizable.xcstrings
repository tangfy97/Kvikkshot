    "“%@” can't be read. Kvikkshot supports formats macOS can play, such as MP4, MOV and M4V. MKV, AVI and WebM need to be converted first.": {
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” can't be read. Kvikkshot supports formats macOS can play, such as MP4, MOV and M4V. MKV, AVI and WebM need to be converted first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”无法读取。Kvikkshot 支持 macOS 能播放的格式，如 MP4、MOV、M4V；MKV、AVI、WebM 需要先转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無法讀取。Kvikkshot 支援 macOS 能播放的格式，例如 MP4、MOV、M4V；MKV、AVI、WebM 需要先轉檔。"
          }
        }
      }
    }
